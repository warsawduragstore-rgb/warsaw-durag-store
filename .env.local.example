# Warsaw Durag Store — Supabase Configuration
# Uzyskaj dane w: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=twoj-klucz-anon-jwt

# Opcjonalny klucz serwisowy (tylko dla operacji serwerowych i Edge Functions)
# SUPABASE_SERVICE_ROLE_KEY=twoj-service-role-key

# Panel CMS Admin Security (ustaw własne silne hasło na produkcji)
ADMIN_PASSWORD=twoje-bezpieczne-haslo-admina
ADMIN_SESSION_SECRET=wygeneruj-losowy-tajny-klucz-sesji-np-openssl-rand-hex-32
